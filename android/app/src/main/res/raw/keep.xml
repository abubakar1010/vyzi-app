<?xml version="1.0" encoding="utf-8"?>
<!--
  Resources isShrinkResources must not remove.

  notification_sound is only named by Dart code and FCM payloads, as
  strings the shrinker cannot see, so without this entry it is removed and
  every notification falls back to the system sound.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@raw/notification_sound"
    tools:shrinkMode="safe" />
